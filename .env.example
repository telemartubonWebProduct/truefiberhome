# Set a matching value in each environment-specific file.
APP_ENV=development

# Public Supabase settings. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=banners

# Server-only Supabase settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy fallback, only when the project does not have a new secret key:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
SUPABASE_STORAGE_BUCKET=banners

# OpenRouter content agents. Each agent can use a different model.
OPENROUTER_API_KEY=sk-or-v1-xxx
PROMOTION_AGENT_MODEL=openai/gpt-4.1-mini
SITE_CONTENT_AGENT_MODEL=google/gemini-3.1-flash-lite-preview
ARTICLE_AGENT_MODEL=google/gemini-3-flash-preview
CRON_SECRET=replace-with-a-long-random-secret

# Prisma must point to the same project ref as NEXT_PUBLIC_SUPABASE_URL.
DATABASE_URL=postgresql://postgres.your-project-ref:password@pooler-host:6543/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
